# Copy to .env for local development, or paste these keys into your hosting
# platform's environment-variable panel. Never commit a filled-in .env.

# ---------------------------------------------------------------------------
# SERVER
# PORT is normally injected by the hosting platform. Leave it unset locally to
# default to 3000. NODE_ENV is set automatically when running dist/server.cjs.
# ---------------------------------------------------------------------------
PORT=
NODE_ENV=

# ---------------------------------------------------------------------------
# DATABASE (Supabase — use the "Session pooler" connection string, port 5432)
# Supabase dashboard -> Connect -> Session pooler. Example:
#   postgresql://postgres.abcxyz:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=postgres
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
# "true" for managed Postgres that enforces TLS (Supabase, Neon, RDS).
SQL_SSL=true

# ---------------------------------------------------------------------------
# EMAIL (SMTP) — sends payment instructions to the guest and a heads-up to
# staff. Optional: if SMTP_HOST is blank, bookings still succeed and the ticket
# still shows everything; the email is skipped and logged to the console.
# Gmail requires an App Password, not the account password.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Ledge <no-reply@theledge.example>

# ---------------------------------------------------------------------------
# ADMIN BOOTSTRAP — read ONLY on first run against a database with no admin
# account. Leave ADMIN_INITIAL_PASSWORD blank and the server generates a random
# one and prints it to the console once. Remove both after the first boot.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
